model UserProfile {
  id          String   @id @default(uuid())
  firstName   String?
  lastName    String?
  photoUrl    String?
  phone       String?
  country     String?
  dateOfBirth DateTime?
  language    String?
  timezone    String?
  bio         String?
  receiveNotifications Boolean @default(true)
  showEmail            Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}
